{
    "name": "sim_p3",
    "model_parameters": {
        "num_classes": 1,
        "num_queries": 100,
        "d_model": 256,
        "n_heads": 4,
        "n_encoder_layers": 3,
        "n_decoder_layers": 3,
        "n_points": 4,
        "dim_ffn": 512,
        "dropout": 0.1,
        "activation": "relu",
        "mlp_hidden_dim": 128,
        "mlp_num_layers": 3
    },
    "training": {
        "dataset": "experiments/datasets/sim_p3.dataset.json",
        "finetune": null,
        "batch_size": 1,
        "num_epochs": 40,
        "lr": 1e-4,
        "weight_decay": 1e-4,
        "num_workers": 8,
        "seed": 42,
        "cost_class": 2.0,
        "cost_l1": 3.0,
        "cost_giou": 1.0,
        "img_size": 512
    },
    "augmentations": [
        {
            "name": "RandomMasking",
            "params": {
                "p": 0.5,
                "min_width": 0.02,
                "max_width": 0.2,
                "min_height": 0.02,
                "max_height": 0.2,
                "max_rectangles": 4
            }
        },
        {
            "name": "RandomFlip",
            "params": {
                "p": 0.3,
                "direction": "vertical"
            }
        },
        {
            "name": "RandomFlip",
            "params": {
                "p": 0.3,
                "direction": "horizontal"
            }
        },
        {
            "name": "RandomQuarterTurn",
            "params": {
                "p": 0.3
            }
        },
        {
            "name": "GaussianBlur",
            "params": {
                "p": 0.2,
                "kernel_size": 3,
                "sigma": [0.1, 1.0]
            }
        },
        {
            "name": "ColorJitter",
            "params": {
                "p": 0.5,
                "brightness": 0.2,
                "saturation": 0.2,
                "contrast": 0.2,
                "hue": 0.02
            }
        },
        {
            "name": "HorizontalShift",
            "params": {
                "p": 0.5,
                "max_displacement": 0.2
            }
        },
        {
            "name": "VerticalShift",
            "params": {
                "p": 0.5,
                "max_displacement": 0.2
            }
        }
    ]
}